<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2000/xaml" xmlns:local="clr-namespace:DietAppWorking" x:Class="DietAppWorking.MainWindow" x:CompileBindings="False" Title="DietApp" Width="850" Height="550" WindowStartupLocation="CenterScreen"><Grid Background="#F5F5F7"><Border IsVisible="{Binding !IsLoggedIn}" HorizontalAlignment="Center" VerticalAlignment="Center" Background="White" CornerRadius="12" Padding="30" Width="380"><StackPanel Spacing="15"><TextBlock Text="Авторизація в DietApp" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/><TextBox Text="{Binding RegUsername}" Watermark="Введіть ім я"/><TextBox Text="{Binding RegEmail}" Watermark="email@example.com"/><TextBox Text="{Binding RegPassword}" PasswordChar="*" Watermark="******"/><Button Content="Увійти" Command="{Binding RegisterOrLogin}" Background="#007AFF" Foreground="White" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/><TextBlock Text="{Binding AuthMessage}" Foreground="Red" HorizontalAlignment="Center"/></StackPanel></Border><Grid IsVisible="{Binding IsLoggedIn}" ColumnDefinitions="220,*"><Border Grid.Column="0" Background="#1E293B" Padding="15"><StackPanel Spacing="20"><TextBlock Text="DIET APP" Foreground="White" FontSize="20" FontWeight="Bold"/><TextBlock Text="{Binding UserName}" Foreground="White" FontSize="16"/><Button Content="Вийти" Command="{Binding Logout}" Background="#EF4444" Foreground="White"/></StackPanel></Border><ScrollViewer Grid.Column="1" Padding="20"><StackPanel Spacing="20"><Border Background="White" CornerRadius="10" Padding="15"><TextBlock Text="{Binding StatusText}" FontSize="18" FontWeight="Bold"/></Border><Border Background="White" CornerRadius="10" Padding="15"><StackPanel Spacing="10"><TextBlock Text="Вписати калорії напряму" FontSize="16" FontWeight="Bold"/><Grid ColumnDefinitions="*,*,Auto"><TextBox Grid.Column="0" Text="{Binding CustomFoodName}" Watermark="Назва"/><TextBox Grid.Column="1" Text="{Binding CustomCaloriesInput}" Watermark="Калорії"/><Button Grid.Column="2" Content="Додати" Command="{Binding AddCustomCalories}" Background="#10B981" Foreground="White"/></Grid></StackPanel></Border><Border Background="White" CornerRadius="10" Padding="15"><StackPanel Spacing="10"><TextBlock Text="Щоденник:" FontSize="16" FontWeight="Bold"/><ListBox ItemsSource="{Binding LoggedEntries}" MinHeight="120"/></StackPanel></Border></StackPanel></ScrollViewer></Grid></Grid></Window>
