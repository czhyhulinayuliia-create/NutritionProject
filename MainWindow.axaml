<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FinalNutritionProject"
        x:Class="FinalNutritionProject.MainWindow"
        x:DataType="vm:MainDashboardViewModel"
        Title="NutriLife - Планувальник Раціону"
        Width="1050" Height="700"
        WindowStartupLocation="CenterScreen">

    <Grid ColumnDefinitions="320, *">
        <Border Grid.Column="0" Background="#2D2D30" Padding="15">
            <ScrollViewer>
                <StackPanel Spacing="12">
                    <TextBlock Text="Авторизація" Foreground="White" FontSize="16" FontWeight="Bold"/>
                    <TextBox Text="{Binding AuthLogin}" Watermark="Логін..."/>
                    <TextBox Text="{Binding AuthToken}" Watermark="Токен..."/>
                    <Button Content="Увійти" Command="{Binding ProcessAuthCommand}" HorizontalAlignment="Stretch"/>
                    <TextBlock Text="{Binding SystemStatus}" Foreground="#FFB300" FontWeight="Bold"/>

                    <Separator Background="#555" Margin="0,5"/>

                    <TextBlock Text="Параметри тіла" Foreground="White" FontSize="16" FontWeight="Bold"/>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBox Text="{Binding UserWeight}" Watermark="Вага (кг)" Width="85"/>
                        <TextBox Text="{Binding UserHeight}" Watermark="Ріст (см)" Width="85"/>
                        <TextBox Text="{Binding UserAge}" Watermark="Вік" Width="85"/>
                    </StackPanel>

                    <TextBlock Text="Рівень активності" Foreground="White" Margin="0,5,0,0"/>
                    <ComboBox SelectedIndex="{Binding ActivityRatingIndex}" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="Низька (сидяча робота)"/>
                        <ComboBoxItem Content="Помірна (1-3 тренування)"/>
                        <ComboBoxItem Content="Висока (4+ тренування)"/>
                    </ComboBox>

                    <TextBlock Text="Ціль" Foreground="White" Margin="0,5,0,0"/>
                    <ComboBox SelectedIndex="{Binding StrategyTargetIndex}" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="Схуднення (-500 ккал)"/>
                        <ComboBoxItem Content="Підтримка ваги"/>
                        <ComboBoxItem Content="Набір маси (+400 ккал)"/>
                    </ComboBox>

                    <TextBlock Text="Стоп-слова (через кому)" Foreground="White" Margin="0,5,0,0"/>
                    <TextBox Text="{Binding StopWordsInput}" Watermark="напр. риба, лактоза..."/>

                    <Button Content="Сформувати раціон" Command="{Binding BuildDietStructureCommand}" 
                            Background="#007ACC" Foreground="White" FontWeight="Bold" 
                            HorizontalAlignment="Stretch" Margin="0,10,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid Grid.Column="1" RowDefinitions="Auto, *, Auto" Margin="15">
            <Border Grid.Row="0" Background="#3E3E42" CornerRadius="5" Padding="15" Margin="0,0,0,10">
                <Grid ColumnDefinitions="*, *">
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Денна норма:" Foreground="#AAA"/>
                        <TextBlock Text="{Binding EnergySummaryText}" Foreground="White" FontSize="22" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Макронутрієнти:" Foreground="#AAA"/>
                        <TextBlock Text="{Binding DistributionSummaryText}" Foreground="#4EC9B0" FontSize="18" FontWeight="Bold"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" RowDefinitions="Auto, *">
                <TextBox Text="{Binding FilterQuery}" Watermark="Швидкий пошук страви..." Margin="0,0,0,8"/>
                
                <ListBox Grid.Row="1" ItemsSource="{Binding ActiveDietCollection}" 
                         SelectedItem="{Binding TargetSelectedDish}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:DisplayDish">
                            <Grid ColumnDefinitions="80, *, 90">
                                <Border Grid.Column="0" Background="#007ACC" CornerRadius="3" Padding="4" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding GroupLabel}" Foreground="White" FontSize="11" HorizontalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0">
                                    <TextBlock Text="{Binding Title}" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Tags}" Foreground="#888" FontSize="11"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding EnergyValue, StringFormat='{}{0} ккал'}" 
                                           HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="Bold"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,10,0,0">
                <Button Content="Видалити обрану страву" Command="{Binding RemoveDishCommand}" Background="#C55353" Foreground="White"/>
                <Button Content="Експортувати раціон" Command="{Binding FileExportCommand}" Background="#28A745" Foreground="White"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>