<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FinalNutritionProject"
        x:Class="FinalNutritionProject.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="NutriLife - Персональний планувальник харчування"
        Width="1050" Height="720" WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <Border IsVisible="{Binding IsLoggedOut}" VerticalAlignment="Center" HorizontalAlignment="Center"
                Background="#F5F5F5" CornerRadius="10" Padding="30" Width="400">
            <StackPanel Spacing="15">
                <TextBlock Text="Ласкаво просимо до NutriLife" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>

                <TabControl>
                    <TabItem Header="Вхід у систему">
                        <Border Padding="0,15,0,0">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Авторизація користувача" FontWeight="SemiBold"/>
                                <TextBox Text="{Binding AuthUsername}" Watermark="Введіть ваш логін"/>
                                <TextBox Text="{Binding AuthPassword}" PasswordChar="*" Watermark="Введіть ваш пароль"/>
                                <Button Content="Увійти в акаунт" Command="{Binding LoginCommand}" 
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </TabItem>

                    <TabItem Header="Реєстрація">
                        <Border Padding="0,15,0,0">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Створення нового акаунта" FontWeight="SemiBold"/>
                                <TextBox Text="{Binding AuthUsername}" Watermark="Придумайте новий логін"/>
                                <TextBox Text="{Binding AuthPassword}" PasswordChar="*" Watermark="Придумайте пароль"/>
                                <Button Content="Зареєструватися" Command="{Binding RegisterCommand}" 
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </TabItem>
                </TabControl>
            </StackPanel>
        </Border>

        <Grid IsVisible="{Binding IsLoggedIn}">
            <TabControl>
                <TabItem Header="Мій профіль та розрахунок">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="15" Margin="10">
                            <TextBlock Text="Антропометричні дані та цілі" FontSize="18" FontWeight="Bold"/>
                            <Grid ColumnDefinitions="150, *" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Вага (кг):" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding InputWeight}" Watermark="Наприклад: 70.5"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Зріст (см):" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding InputHeight}" Watermark="Наприклад: 175"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Вік (років):" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding InputAge}" Watermark="Наприклад: 22"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Стать:" VerticalAlignment="Center"/>
                                <ComboBox Grid.Row="3" Grid.Column="1" SelectedIndex="{Binding SelectedGenderIndex}" HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="Чоловіча"/>
                                    <ComboBoxItem Content="Жіноча"/>
                                </ComboBox>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Активність:" VerticalAlignment="Center"/>
                                <ComboBox Grid.Row="4" Grid.Column="1" SelectedIndex="{Binding SelectedActivityIndex}" HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="Мінімальна (сидячий спосіб життя)"/>
                                    <ComboBoxItem Content="Слабка (легкі тренування 1-3 рази/тиж)"/>
                                    <ComboBoxItem Content="Середня (тренування 3-5 разів/тиж)"/>
                                    <ComboBoxItem Content="Висока (інтенсивні тренування)"/>
                                </ComboBox>

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Ціль:" VerticalAlignment="Center"/>
                                <ComboBox Grid.Row="5" Grid.Column="1" SelectedIndex="{Binding SelectedGoalIndex}" HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="Схуднення (-15%)"/>
                                    <ComboBoxItem Content="Підтримання ваги"/>
                                    <ComboBoxItem Content="Набір маси (+15%)"/>
                                </ComboBox>

                                <TextBlock Grid.Row="6" Grid.Column="0" Text="Алергії / Виключення:" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding InputAllergies}" Watermark="Наприклад: горіхи, молоко"/>
                            </Grid>

                            <Button Content="Розрахувати добову норму" Command="{Binding SaveProfileAndCalculateCommand}" 
                                    HorizontalAlignment="Left" Padding="15,8"/>

                            <Border Background="#EFEFEF" Padding="15" CornerRadius="8" Margin="0,10,0,0">
                                <TextBlock Text="{Binding CalculationResultText}" TextWrapping="Wrap" FontSize="14" FontWeight="Medium"/>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Каталог та управління стравами">
                    <Grid RowDefinitions="Auto, *" ColumnDefinitions="*, 360" Margin="10">
                        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Spacing="10" Margin="0,0,0,10">
                            <TextBox Text="{Binding SearchQuery}" Watermark="Пошук страви за назвою або тегом..." />
                        </StackPanel>

                        <ListBox Grid.Row="1" Grid.Column="0" ItemsSource="{Binding Dishes}" SelectedItem="{Binding SelectedDish}" Margin="0,0,10,0">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="vm:DishItem">
                                    <Border Padding="8" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                                        <Grid ColumnDefinitions="*, Auto">
                                            <StackPanel Grid.Column="0" Spacing="2">
                                                <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="14"/>
                                                <TextBlock Text="{Binding Category, StringFormat='Категорія: {0}'}" FontSize="12" Foreground="Gray"/>
                                            </StackPanel>
                                            
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding Calories, StringFormat='{}🔥 {0} ккал'}" FontWeight="Bold" Foreground="#D32F2F" HorizontalAlignment="Right"/>
                                                <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                                                    <TextBlock Text="{Binding Protein, StringFormat='Б: {0}г'}" FontSize="11" Foreground="#555555"/>
                                                    <TextBlock Text="|" FontSize="11" Foreground="#999999"/>
                                                    <TextBlock Text="{Binding Fat, StringFormat='Ж: {0}г'}" FontSize="11" Foreground="#555555"/>
                                                    <TextBlock Text="|" FontSize="11" Foreground="#999999"/>
                                                    <TextBlock Text="{Binding Carbs, StringFormat='В: {0}г'}" FontSize="11" Foreground="#555555"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="15">
                                <Border Background="#E3F2FD" Padding="15" CornerRadius="8" IsVisible="{Binding SelectedDish, Converter={x:Static ObjectConverters.IsNotNull}}">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Обрана страва" FontWeight="Bold" FontSize="15" Foreground="#1565C0"/>
                                        <TextBlock Text="{Binding SelectedDish.Title}" FontSize="16" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding SelectedDish.Calories, StringFormat='Калорійність: {0} ккал (порція {1}г)'}" Foreground="#D32F2F" FontWeight="SemiBold"/>
                                        <Separator Height="1" Background="#B3E5FC"/>
                                        <TextBlock Text="{Binding SelectedDish.Protein, StringFormat='• Білки: {0} г'}"/>
                                        <TextBlock Text="{Binding SelectedDish.Fat, StringFormat='• Жири: {0} г'}"/>
                                        <TextBlock Text="{Binding SelectedDish.Carbs, StringFormat='• Вуглеводи: {0} г'}"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="#F9F9F9" Padding="15" CornerRadius="8">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Додати нову страву" FontWeight="Bold" FontSize="15"/>
                                        
                                        <TextBox Text="{Binding NewDishTitle}" Watermark="Назва страви"/>
                                        <TextBox Text="{Binding NewDishCategory}" Watermark="Категорія (Сніданок/Обід/...)"/>
                                        <TextBox Text="{Binding NewDishCalories}" Watermark="Калорії (ккал)"/>
                                        <TextBox Text="{Binding NewDishProtein}" Watermark="Білки (г)"/>
                                        <TextBox Text="{Binding NewDishFat}" Watermark="Жири (г)"/>
                                        <TextBox Text="{Binding NewDishCarbs}" Watermark="Вуглеводи (г)"/>
                                        <TextBox Text="{Binding NewDishServingSize}" Watermark="Порція (г)"/>
                                        <TextBox Text="{Binding NewDishTags}" Watermark="Теги через кому"/>

                                        <Button Content="Зберегти страву" Command="{Binding CreateDishCommand}" 
                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>